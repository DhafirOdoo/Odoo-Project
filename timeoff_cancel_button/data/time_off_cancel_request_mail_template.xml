<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="time_off_cancel_request_template" model="mail.template">
            <field name="name">Leave Cancel Request Template</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="subject">{{ object.holiday_status_id.name }} Cancellation Request from {{ object.employee_id.name }}</field>
            <field name="email_to">{{ object.employee_id.leave_manager_id.work_email }}</field>
            <field name="email_from">{{ object.employee_id.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>
                        Dear
                        <t t-out="object.employee_id.leave_manager_id.name"/>
                    </p>
                    <p>
                        <t t-out="object.employee_id.name"/>
                        has requested the cancellation of
                        <t t-out="object.holiday_status_id.name"/>
                        applied on <t t-out="object.create_date.strftime('%d/%m/%y')"/>
                    </p>
                    <p>
                        <b>Leave Details:</b>
                    </p>
                    <ul>
                      <li> <b>From: </b> <t t-out="object.request_date_from.strftime('%d/%m/%y')"/><b> To: </b> <t t-out="object.request_date_to.strftime('%d/%m/%y')"/></li>
                      <li> <b>Duration: </b>  <t t-out="object.number_of_days_display"/> days
                          <t t-if="object.request_unit_half">
                            (<t t-out="dict(object.fields_get(['request_date_from_period'])['request_date_from_period']['selection']).get(object.request_date_from_period)"/>)
                          </t>
                      </li>
                      <li> <b>Reason for Cancellation : </b>  <t t-out="object.cancel_reason"/></li>
                    </ul>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>