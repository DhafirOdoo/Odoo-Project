<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="time_off_cancel_request_wizard_form" model="ir.ui.view">
            <field name="name">time.off.cancel.request.form</field>
            <field name="model">timeoff.cancel.request.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="leave_id" invisible="1"/>
                        <field name="reason"/>
                    </group>
                    <footer>
                        <button string="Submit" class="btn-primary" name="request_submit" type="object"/>
                        <button string="Discard" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>