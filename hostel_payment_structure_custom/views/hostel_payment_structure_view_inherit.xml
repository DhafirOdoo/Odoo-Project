<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hostel_payment_structure_view_inherit" model="ir.ui.view">
            <field name="name">hostel.payment.structure.view.inherit</field>
            <field name="model">admission.invoice</field>
            <field name="inherit_id" ref="dev_hostel_management.dev_hostel_admission_invoice_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="student_admission_id" string="Name"/>
                </xpath>
            </field>
        </record>
        <record id="hostel_payment_structure_search_inherit" model="ir.ui.view">
            <field name="name">hostel.payment.structure.view.inherit</field>
            <field name="model">admission.invoice</field>
            <field name="inherit_id" ref="dev_hostel_management.search_admission_admission_invoice"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="student_admission_id" string="Name"/>
                    <field name="date" string="Date"/>
                    <filter string="Active Admission" name="active_admission" domain="[('student_admission_id.state', '=', 'confirm')]"/>
                </xpath>

            </field>
        </record>
        <record id="dev_hostel_management.action_dev_hostel_admission_payment" model="ir.actions.act_window">
            <field name="context">
                {'search_default_active_admission': 1}
            </field>
        </record>

    </data>
</odoo>