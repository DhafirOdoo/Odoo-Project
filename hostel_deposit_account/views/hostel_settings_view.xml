<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hostel_settings_deposit_account" model="ir.ui.view">
            <field name="name">hostel.settings.deposit.account</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="dev_hostel_management.config_hostel_journal_account_inherited"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='hostel_block_2']" position="inside">
                    <setting id="hostel_setting_deposit">
                        <div class="content-group" name="hostel_settings_deposit_div">
                            <div class="d-flex">
                                <label for="hostel_deposit_account_id" class="o_light_label"/>
                                <field name="hostel_deposit_account_id" class="ml16"/>
                            </div>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>