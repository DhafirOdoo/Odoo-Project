<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="daily_report_view_tree" model="ir.ui.view">
            <field name="name">daily.report.view.tree</field>
            <field name="model">daily.report</field>
            <field name="arch" type="xml">
                <tree default_order="report_date desc">
                    <field name="employee_id"/>
                    <field name="report_date"/>
                    <field name="status" widget="badge"
                        decoration-info="status == 'submitted'"
                    />
                </tree>
            </field>
        </record>
        <record id="daily_report_view_form" model="ir.ui.view">
            <field name="name">daily.report.view.form</field>
            <field name="model">daily.report</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_submit" class="btn btn-primary" type="object" string="Submit"
                                invisible="status == 'submitted'"/>
                        <button name="button_reset" type="object" string="Reset to draft"
                                invisible="status != 'submitted'"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,submitted"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                            </group>
                            <group>
                                <field name="report_date" readonly="status == 'submitted'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Daily Work Report">
                               <field name="line_ids" readonly="status == 'submitted'">
                                   <tree editable="bottom">
                                       <field name="activity_id"/>
                                       <field name="count"/>
                                       <field name="work_time" widget="float_time" sum="Total"/>
                                   </tree>
                               </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="daily_report_search" model="ir.ui.view">
            <field name="name">daily.report.search</field>
            <field name="model">daily.report</field>
            <field name="arch" type="xml">
                <search>
                    <filter name="today"
                            string="Today"
                            domain="[('report_date','=',context_today())]"/>
                </search>
            </field>
        </record>
        <record id="my_report_action" model="ir.actions.act_window">
            <field name="name">Daily Report</field>
            <field name="res_model">daily.report</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('create_uid', '=', uid)]</field>
        </record>
         <record id="manage_report_action" model="ir.actions.act_window">
            <field name="name">Daily Report</field>
            <field name="res_model">daily.report</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_today': 1}</field>
            <field name="domain">[('status', '=', 'submitted')]</field>
        </record>
    </data>
</odoo>