<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="daily_report_access" model="ir.module.category">
            <field name="name">Daily Report</field>
        </record>
        <record id="daily_report_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="daily_report_access"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="daily_report_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="daily_report_access"/>
            <field name="implied_ids" eval="[(4, ref('daily_report.daily_report_user'))]"/>
             <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>