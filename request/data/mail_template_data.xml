<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="employee_request_approver_mail" model="mail.template">
            <field name="name">Employee Request Submit</field>
            <field name="model_id" ref="request.model_employee_request"/>
            <field name="subject">{{ object.request_type_id.request_name}} submitted by {{ object.employee_id.name}} [Dhafir INDIA]</field>
            <field name="email_from">{{ object.employee_id.work_email }}</field>
            <field name="email_to">{{ object.request_type_id.approver_id.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>
                        <b>
                            Dear
                        <t t-out="object.request_type_id.approver_id.name"/>,
                        </b>
                    </p>



                    <p>
                        <b><t t-out="object.employee_id.name"/></b>
                        has submitted a
                        <b>
                            <t t-out="object.request_type_id.request_name"/>
                        </b>
                        on
                        <t t-out="format_datetime(object.create_date, dt_format='dd-MM-yyyy')"/>.
                    </p>
                    <p>
                        <b>
                            Request History :
                        </b>
                    </p>
                    <p>
                        <table class="table table-sm table-bordered" style="border: 1px solid black;">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>
                                        <t t-if="object.is_early">
                                            Early Exit Time
                                        </t>
                                        <t t-if="object.is_late">
                                             Late Login Time
                                        </t>
                                    </th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <span t-field="object.login_date_time"/>
                                    </td>
                                    <td>
                                        <t t-if="object.is_early">
                                            <span t-field="object.early_time"  t-options='{"widget": "float_time"}'/>
                                        </t>
                                        <t t-if="object.is_late">
                                            <span t-field="object.late_time" t-options='{"widget": "float_time"}'/>
                                        </t>

                                    </td>
                                    <td>
                                        <span t-field="object.display_note"/>
                                    </td>
                                </tr>
                                <tr t-foreach="object.previous_request_ids[:2]" t-as="request">
                                    <td>
                                        <span t-field="request.login_date_time"/>
                                    </td>
                                    <td>
                                        <t t-if="object.is_early">
                                            <span t-field="request.early_time"  t-options='{"widget": "float_time"}'/>
                                        </t>
                                        <t t-if="object.is_late">
                                            <span t-field="request.late_time" t-options='{"widget": "float_time"}'/>
                                        </t>

                                    </td>
                                    <td>
                                        <span t-field="request.display_note"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </p>

                    <p>Kindly review the request.</p>
                    <br>

                    </br>

                    <t t-set="base_url" t-value="object.get_base_url()"/>
                    <table role="presentation" width="100%">
                        <tr>
                            <td align="center">
                                <a t-attf-href="{{ base_url }}/web#id={{ object.id }}&amp;model=employee.request&amp;view_type=form"
                                   style="background:#875A7B;
                                          color:#ffffff;
                                          padding:10px 18px;
                                          text-decoration:none;
                                          border-radius:5px;
                                          display:inline-block;">
                                    View Request
                                </a>
                            </td>
                        </tr>
                    </table>
                    <br>

                    </br>
                    <p>
                        <b>
                            Thanks &amp; Regards,<br/>
                            <t t-out="user.signature"/>
                        </b>
                    </p>
                </div>
            </field>

            <field name="auto_delete" eval="True"/>

        </record>
    </data>
</odoo>