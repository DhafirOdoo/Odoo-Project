<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="employee_request_list" model="ir.ui.view">
            <field name="name">employee.request.list</field>
            <field name="model">employee.request</field>
            <field name="arch" type="xml">
                <tree default_order="login_date_time desc">
                    <field name="employee_id"/>
                    <field name="request_type_id"/>
                    <field name="login_date_time"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'approved'"
                           decoration-danger="status == 'rejected'"
                           decoration-info="status == 'submitted'"
                           decoration-primary="status == 'compensated'"
                           decoration-muted="status == 'draft'"/>
                </tree>
            </field>
        </record>
        <record id="employee_request_form" model="ir.ui.view">
            <field name="name">employee.request.form</field>
            <field name="model">employee.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_submit" class="btn btn-primary" type="object" string="Submit"
                                invisible="status != 'draft'"/>
                        <button name="button_approve" class="btn btn-primary" type="object" string="Approve"
                                invisible="status != 'submitted'" groups="request.request_approver"/>
                        <button name="button_reject" string="Reject" type="object" invisible="status !='submitted'"
                                groups="request.request_approver"/>
                        <button name="button_compensate" class="btn btn-primary" string="Compensate" type="object"
                                invisible="status !='approved' or user_id != uid or (not is_early and not is_late)"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="user_id" invisible="1"/>
                                <field name="request_type_id" options="{'no_create': True}"
                                       readonly="status != 'draft'"/>
                                <field name="req_reason"
                                       invisible="is_late or is_early"
                                       readonly="status != 'draft'"
                                       required="1"/>
                                <field name="login_reason"
                                       invisible="not (is_late or is_early)"
                                       readonly="status != 'draft'"
                                       required="1"/>
                            </group>
                            <group>
                                <field name="login_date_time" options="{'minuteStep': 1}"
                                       readonly="status != 'draft'"/>
                                <field name="is_late" invisible="1"/>
                                <label for="late_time" string="Late Login Time" invisible="not is_late"/>
                                <div class="o_row" invisible="not is_late">
                                    <field name="late_time"
                                       invisible="not is_late"
                                       widget="float_time"
                                       readonly="status != 'draft'" class="oe_inline"/>
                                    <span class="text-warning">Total Duration</span>
                                    <field name="late_duration" widget="float_time"
                                           readonly="status != 'draft'"
                                           class="oe_inline text-warning"/>
                                </div>
                                <field name="is_early" invisible="1"/>
                                <label for="early_time" string="Early Exit Time" invisible="not is_early"/>
                                <div class="o_row" invisible="not is_early">
                                    <field name="early_time"
                                       invisible="not is_early"
                                       widget="float_time"
                                       class="oe_inline"
                                       readonly="status != 'draft'"/>
                                    <span class="text-warning">Total Duration</span>
                                    <field name="early_duration"
                                           class="oe_inline text-warning"
                                           readonly="status != 'draft'"
                                           widget="float_time"/>
                                </div>
                                <field name="compensate_date" invisible="status in ['draft','submitted','rejected'] or (not is_early and not is_late)" readonly="status =='compensated'"/>
                                <label for="from_time" string="Compensated From" invisible="status in ['draft','submitted','rejected'] or (not is_early and not is_late)"/>
                                <div class="o_row" invisible="status in ['draft','submitted','rejected'] or (not is_early and not is_late)">
                                    <field name="from_time" widget="float_time" class="oe_inline" readonly="status =='compensated'"/>
                                    <span> <b>To</b> </span>
                                    <field name="to_time" widget="float_time" class="oe_inline" readonly="status =='compensated'"/>
                                    <span class="text-success">Total</span>
                                    <field name="compensate_duration" widget="float_time" class="oe_inline text-success"/>
                                </div>
                                <field name="approver_id"/>

                            </group>
                        </group>
                        <notebook>
                            <page string="Request History">
                                <field name="previous_request_ids" readonly="1">
                                    <tree default_order="id desc" limit="5">
                                        <field name="login_date_time"/>
                                        <field name="request_type_id"/>
                                        <field name="display_note"/>
                                        <field name="status"  decoration-success="status == 'compensated'"/>
                                        <field name="compensate_date"
                                               decoration-success="status == 'compensated'"/>
                                        <field name="from_time" widget="float_time"
                                               decoration-success="status == 'compensated'"
                                               decoration-danger="status == 'approved'"/>
                                        <field name="to_time" widget="float_time"
                                               decoration-success="status == 'compensated'"
                                               decoration-danger="status == 'approved'"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="employee_request_search" model="ir.ui.view">
            <field name="name">employee.request.search</field>
            <field name="model">employee.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="request_type_id"/>
                    <field name="login_date_time"/>
                    <filter name="to_approve"
                            string="To Approve or Compensate"
                            domain="[('status', 'in', ['submitted', 'draft', 'approved'])]"/>
                    <filter name="to_approve_manager"
                            string="To Approve"
                            invisible="1"
                            domain="[('status', 'in', ['submitted', 'draft'])]"/>
                    <filter name="compensated"
                            string="Compensated"
                            domain="[('status','=','compensated')]"/>
                    <separator/>
                    <group>
                        <filter name="group_employee"
                                string="Employee"
                                context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="my_request_action" model="ir.actions.act_window">
            <field name="name">Employee Request</field>
            <field name="res_model">employee.request</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="employee_request_search"/>
            <field name="context">{'search_default_to_approve':1}</field>
            <field name="domain">[('create_uid', '=', uid)]</field>
        </record>
        <record id="manage_request_action" model="ir.actions.act_window">
            <field name="name">Employee Request</field>
            <field name="res_model">employee.request</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="employee_request_search"/>
            <field name="context">{'search_default_to_approve_manager':1}</field>
            <field name="domain">[('status', 'in', ['submitted', 'approved', 'rejected','compensated'])]</field>
        </record>
    </data>
</odoo>