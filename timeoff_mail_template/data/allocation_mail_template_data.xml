<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--        Leave Allocation Mail Template-->
        <record id="allocation_request_mail" model="mail.template">
            <field name="name">Leave Allocation Request Mail</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="subject">{{ object.holiday_status_id.name }} allocation request from {{ object.employee_id.name }} [Dhafir INDIA]</field>
            <field name="email_from">{{ object.employee_id.work_email }}</field>
            <field name="email_to">{{ object.employee_id.leave_manager_id.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>
                       <b>Dear</b>
                       <b><t t-out="object.employee_id.leave_manager_id.name"/>,</b>
                    </p>
                    <br/>
                    <p>
                        <b><t t-out="object.employee_id.name"/></b>
                        has submitted a
                       <b> <t t-out="object.holiday_status_id.name"/> </b>
                        allocation request.
                    </p>
                    <p>
                        <b>Allocation Request Details:</b>
                    </p>
                    <ul>
                      <li> <b>Requested Days : </b> <t t-out="object.number_of_days_display"/></li>
                      <li> <b>Description : </b>  <t t-out="object.notes"/></li>
                    </ul>
                    <br/>
                    <p>
                        Kindly review the request.

                    </p>
                    <div style="margin-top:20px; display:flex; justify-content:center; align-items:center;">
                        <a t-attf-href="/web#id={{ object.id }}&amp;model=hr.leave.allocation&amp;view_type=form"
                           style="background:#875A7B;
                                  color:white;
                                  padding:10px 18px;
                                  text-decoration:none;
                                  border-radius:5px;
                                  margin-right:10px;
                                  display:inline-block;">
                            View Request
                        </a>

                    </div>
                    <br>

                    </br>
                    <p>
                        <b>
                            Thanks &amp; Regards,<br/>
                            <t t-out="user.signature"/>
                        </b>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>