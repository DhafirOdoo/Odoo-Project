<!--                                  color:white;-->
<!--                                  padding:10px 18px;-->
<!--                                  text-decoration:none;-->
<!--                                  border-radius:5px;-->
<!--                                  margin-right:10px;-->
<!--                                  display:inline-block;">-->
<!--                            Validate-->
<!--                        </a>-->

                        <!-- Refuse Button -->
<!--                        <a t-attf-href="/leave/refuse/{{ object.id }}"-->
<!--                           style="background:#dc3545;-->
<!--                                  color:white;-->
<!--                                  padding:10px 18px;-->
<!--                                  text-decoration:none;-->
<!--                                  border-radius:5px;-->
<!--                                  display:inline-block;">-->
<!--                            Refuse-->
<!--                        </a>-->
                    </div>
                    <br>


                    </br>
                    <p>
                        <b>
                            Thanks &amp; Regards,<br/>
                            <t t-out="user.signature"/>
                        </b>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>